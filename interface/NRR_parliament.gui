guiTypes = {

	# ========================================================
	#  Entrance Button inside Politics Tab (Below Night Raid Btn)
	# ========================================================
	containerWindowType = {
		name = "NRR_parliament_open_window"
		position = { x = 466 y = 123 }
		size = { width = 56 height = 56 }
		Orientation = UPPER_LEFT

		buttonType = {
			name = "NRR_parliament_open_btn"
			quadTextureSprite = "GFX_NRR_parliament_open_btn"
			position = { x = 0 y = 0 }
			pdx_tooltip = "NRR_parliament_open_btn_tt"
			pdx_tooltip_delayed = "NRR_parliament_open_btn_desc"
			clicksound = click_default
		}
	}

	# ========================================================
	#  Main Parliament Window (1040 x 740)
	# ========================================================
	containerWindowType = {
		name = "NRR_parliament_main_window"
		position = { x = 0 y = 0 }
		size = { width = 1040 height = 740 }
		Orientation = center
		Origo = center
		clipping = no
		moveable = yes
		click_to_front = yes

		# Window Background
		background = {
			name = "Background"
			spriteType = "GFX_NRR_parliament_bg"
		}

		# Window Title
		instantTextBoxType = {
			name = "NRR_parliament_title"
			position = { x = 30 y = 12 }
			font = "hoi_24header"
			text = "NRR_PARLIAMENT_MAIN_TITLE"
			maxWidth = 500
			maxHeight = 30
			format = left
		}

		# System Type Badge (Unicameral vs Bicameral)
		instantTextBoxType = {
			name = "NRR_parliament_system_type"
			position = { x = 550 y = 14 }
			font = "hoi_18mbs"
			text = "[Root.GetNRRParliamentSystemType]"
			maxWidth = 400
			maxHeight = 25
			format = right
		}

		# Info Icon
		iconType = {
			name = "NRR_parliament_info_icon"
			spriteType = "GFX_NRR_parliament_info_icon"
			position = { x = 964 y = 12 }
			pdx_tooltip = "NRR_PARLIAMENT_INFO_TT"
		}

		# Close Button
		buttonType = {
			name = "NRR_parliament_close_btn"
			position = { x = 998 y = 12 }
			quadTextureSprite = "GFX_closebutton"
			buttonFont = "hoi_16mbs"
			shortcut = "ESCAPE"
			clicksound = click_close
			pdx_tooltip = "CLOSE"
		}

		# --------------------------------------------------------
		#  RIGHT PANEL: National Assembly / House (350 Seats)
